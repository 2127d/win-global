Exec=/usr/bin/python3 -c "import pathlib,runpy,sys; from urllib.parse import unquote,urlparse; p=sys.argv[1]; p=unquote(urlparse(p).path) if p.startswith('file:') else p; runpy.run_path(str(pathlib.Path(p).resolve().parent/'install-gui.py'),run_name='__main__')" %k
Terminal=false
