// Sequoia Eleven desktop preset, captured 2026-10-06.
// Generated by tools/build-desktop-layout.py. Edit desktop/layouts sources.
// KDE runs this only when the user selects the theme's desktop layout.
// KDE owns removal of the previous layout; never remove panels here.
(function () {
    var panelSpecs = @PANELS@;

    function configure(applet, groups) {
        Object.keys(groups).forEach(function (path) {
            applet.currentConfigGroup = path.split('/').filter(function (part) { return part.length > 0; });
            Object.keys(groups[path]).forEach(function (key) {
                applet.writeConfig(key, groups[path][key]);
            });
        });
        applet.currentConfigGroup = [];
        applet.reloadConfig();
    }

    panelSpecs.forEach(function (spec) {
        var panel = new Panel;
        // Screen 0 is Plasma's primary screen; do not carry connector names or
        // monitor counts from the source machine into another installation.
        panel.screen = 0;
        panel.location = spec.location;
        panel.alignment = spec.alignment;
        panel.height = spec.height;
        panel.offset = 0;
        panel.lengthMode = spec.lengthMode;
        panel.hiding = spec.hiding;
        panel.floating = spec.floating;
        if (typeof panel.floatingApplets !== 'undefined') {
            panel.floatingApplets = spec.floatingApplets;
        } else {
            // Plasma 6.7 stores this setting but does not expose a scripting
            // property yet. Seed the new view's config before it is shown.
            var views = new ConfigFile('plasmashellrc', 'PlasmaViews');
            var view = new ConfigFile(views, 'Panel ' + panel.id);
            view.writeEntry('floatingApplets', spec.floatingApplets ? 1 : 0);
        }
        panel.opacity = spec.opacity;
        spec.applets.forEach(function (entry) {
            var widget = panel.addWidget(entry.plugin);
            if (!widget) {
                print('Sequoia Eleven: missing widget ' + entry.plugin);
                return;
            }
            var target = widget;
            if (entry.plugin === 'org.sequoia.systemtray') {
                // Older Plasma releases keep tray settings in a child containment.
                widget.currentConfigGroup = [];
                var trayId = widget.readConfig('SystrayContainmentId', 0);
                if (trayId) target = desktopById(trayId) || widget;
            }
            configure(target, entry.config);
        });
    });

    // One Folder View per attached screen, with the selected theme's wallpaper.
    // Personal wallpaper paths, activity UUIDs and weather locations are not exported.
    desktopsForActivity(currentActivity()).forEach(function (desktop) {
        desktop.wallpaperPlugin = 'org.kde.image';
    });
}());
